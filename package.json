{
  "name": "claude-optchat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OptChat memory for Claude Code: persistent profiles, a zoomable summary tree of every conversation, and conversation imports. A port of pi-optchat.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "tsx --import ./test/support.ts --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "keywords": ["claude-code", "claude-code-plugin", "optchat", "memory"],
  "author": "Jonas",
  "contributors": ["Flo (Claude Code port)"],
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/florianclt/claude-optchat.git" },
  "engines": { "node": ">=22.19.0" }
}
